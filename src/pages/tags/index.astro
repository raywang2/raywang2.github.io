---
import Base from '../../layouts/Base.astro';import {published,termUrl} from '../../lib/posts';
const posts=await published();const terms=[...new Set(posts.flatMap(p=>p.data.tags))].sort();
---
<Base title="標籤"><p class="eyebrow">EXPLORE THE NOTES</p><h1>依標籤閱讀</h1><div class="chips">{terms.map(term=><a href={termUrl('tags',term)}>{term}</a>)}</div></Base>
