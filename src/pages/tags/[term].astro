---
import Base from '../../layouts/Base.astro';import PostList from '../../components/PostList.astro';import {published} from '../../lib/posts';
export async function getStaticPaths(){const posts=await published();return [...new Set(posts.flatMap(p=>p.data.tags))].map(term=>({params:{term},props:{term,posts:posts.filter(p=>p.data.tags.includes(term))}}));}
const {term,posts}=Astro.props;
---
<Base title={`$標籤：${term}`}><p class="eyebrow">標籤</p><h1>{term}</h1><PostList posts={posts}/></Base>
