---
import Base from '../../layouts/Base.astro';import PostList from '../../components/PostList.astro';import {projects} from '../../data/projects';import {published} from '../../lib/posts';
export function getStaticPaths(){return projects.map(project=>({params:{id:project.id},props:{project}}));}
const {project}=Astro.props;const posts=(await published()).filter(p=>p.data.project===project.id);
---
<Base title={project.title} description={project.description}><p class="eyebrow">PROJECT / {project.number}</p><h1>{project.title}</h1><p class="intro">{project.description}</p><div class="chips"><a href={`https://raywang2.github.io/${project.repo}/`}>開啟互動專案 ↗</a><a href={`https://github.com/raywang2/${project.repo}`}>原始碼 ↗</a></div><h2>關聯文章</h2><PostList posts={posts}/></Base>
