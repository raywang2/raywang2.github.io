---
import '../styles/global.css';
interface Props {title?:string;description?:string;article?:{date:Date;updated?:Date};noindex?:boolean}
const {title='工程與遠方',description='RR 的工程、單車與旅行筆記。把想法寫下來，把路慢慢騎完。',article,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const fullTitle=`${title} · RR Field Notes`;
const structured=article?{'@context':'https://schema.org','@type':'BlogPosting',headline:title,description,datePublished:article.date.toISOString(),dateModified:(article.updated??article.date).toISOString(),author:{'@type':'Person',name:'RR'},mainEntityOfPage:canonical.href}:{'@context':'https://schema.org','@type':'WebSite',name:'RR Field Notes',url:Astro.site?.href};
---
<!doctype html><html lang="zh-Hant"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="zh_TW"/><meta name="twitter:card" content="summary"/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="RR RSS" href="/rss.xml"/><link rel="alternate" type="application/feed+json" title="RR JSON Feed" href="/feed.json"/><script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\u003c')}/></head><body><a class="skip" href="#main">跳至主要內容</a><header><a class="brand" href="/">RR<span>FIELD NOTES</span></a><nav aria-label="主要導覽"><a href="/posts/">文章</a><a href="/categories/">分類</a><a href="/tags/">標籤</a><a href="/projects/">專案 ↗</a></nav></header><main id="main"><slot/></main><footer><p>RR Field Notes — 工程與遠方</p><div><a href="/rss.xml">RSS</a> · <a href="/feed.json">JSON Feed</a> · <a href="https://github.com/raywang2">GitHub ↗</a></div></footer></body></html>
